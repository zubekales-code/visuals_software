{
  "name": "visuals-software",
  "version": "0.4.0",
  "description": "Vlastni VJ software (Electron + WebGL2). v0.4: sloupce, nazvy, sjednocene posuvniky, GLOW/STROBO, zvuk PC, 3D sceny (Three.js).",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node build.mjs --tests && node --test \"dist/test/*.test.cjs\"",
    "smoke": "node build.mjs && electron . --smoke"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "three": "^0.186.1"
  }
}
