{
  "name": "visuals-software",
  "version": "0.2.0",
  "description": "Vlastni VJ software (Electron + WebGL2). Etapa 0: test vykonu.",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node build.mjs --tests && node --test \"dist/test/*.test.cjs\"",
    "smoke": "node build.mjs && electron . --smoke"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0"
  }
}
